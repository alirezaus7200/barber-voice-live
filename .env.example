# Copy to .env (never commit .env). All values come from the services' own dashboards.
PORT=8080
# This server's public https address (Twilio calls PUBLIC_URL/twilio/voice; audio on wss://.../twilio/media)
PUBLIC_URL=https://voice.example.com
# Twilio Console -> Account info (the auth token also checks Twilio's request signatures)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# barber-core's voice webhook and this server's own secret (the same value as LIVE_WEBHOOK_SECRET in barber-core's Vercel)
CORE_WEBHOOK_URL=https://barber-core.vercel.app/api/webhooks/vapi
CORE_WEBHOOK_SECRET=
# A long random text (32+ characters) only this server knows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_SECRET=
# Google AI Studio -> Get API key; the Live model with native audio as AI Studio lists it; a voice name (Kore, Puck, ...)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE=Kore
# How readily Gemini hears the start of the caller's speech: HIGH (catches short answers like «بله»), LOW, or empty = Gemini's own
GEMINI_START_SENSITIVITY=
# Milliseconds of speech before Gemini counts it as the caller speaking (0 to 1000), or empty = Gemini's own
GEMINI_PREFIX_PADDING_MS=
